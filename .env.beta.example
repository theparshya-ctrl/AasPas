# AasPas External Beta — Render + Neon (COPY to .env.beta — never commit)
# Isolated from DEV. PostgreSQL + S3-compatible object storage (Neon Object Storage).

APP_NAME=AasPas
APP_ENV=staging
APP_DEBUG=false

HOST=0.0.0.0
# Render sets PORT automatically; local validation may use 8001.

# Neon PostgreSQL (separate Beta project/branch — NOT dev.db)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/aaspas_beta?sslmode=require

SECRET_KEY=replace-with-long-random-beta-secret

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

NEARBY_RADIUS_KM=10
HOME_OFFERS_LIMIT=20
HOME_NEARBY_SHOPS_LIMIT=20
LOG_LEVEL=INFO

# Object storage — Neon Object Storage (S3-compatible)
MEDIA_STORAGE_BACKEND=s3
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=nak_live_replace_me
AWS_SECRET_ACCESS_KEY=nsk_live_replace_me
AWS_S3_BUCKET=aaspas-beta-media

# Public HTTPS base for public_read bucket (NO /media suffix):
# https://<branch-id>.storage.c-<N>.us-east-2.aws.neon.tech/<bucket-name>
MEDIA_PUBLIC_BASE_URL=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech/aaspas-beta-media

# Beta APK in-app updates (CURSOR-062) — stable public object key beta/android/latest.apk
# BETA_APK_DOWNLOAD_URL=https://br-xxx.storage.c-2.us-east-2.aws.neon.tech/aaspas-beta-media/beta/android/latest.apk
# BETA_APK_STORAGE_KEY=beta/android/latest.apk

# Beta admin seed (scripts/seed_beta_admin.py)
BETA_ADMIN_EMAIL=admin@beta.aaspas.local
BETA_ADMIN_PASSWORD=replace-with-strong-beta-admin-password

# --- DEV-only (leave unset on Render Beta) ---
# MEDIA_ROOT=uploads
# MEDIA_URL_PREFIX=/media
