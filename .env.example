# Application
APP_NAME=AasPas
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://aaspas:aaspas@localhost:5432/aaspas

# Security
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Home / geo
NEARBY_RADIUS_KM=10
HOME_OFFERS_LIMIT=20
HOME_NEARBY_SHOPS_LIMIT=20

# Logging
LOG_LEVEL=INFO

# Public URL for uploaded media (must be reachable from phones; optional — launcher may set from Tailscale)
# MEDIA_PUBLIC_BASE_URL=http://100.x.x.x:8000
